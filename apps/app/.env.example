# Mẫu cho apps/app/.env.local (tệp thật bị gitignore). Không có khoá bí mật nào ở đây: khoá anon là khoá công khai.
# `pnpm db:env` tự ghi hai dòng đầu từ `supabase status` và giữ nguyên các dòng còn lại.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# 1 để hiện nút "Đăng nhập bằng Google" (khoá Google đặt trong supabase/.env).
VITE_AUTH_GOOGLE=
