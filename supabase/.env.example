# Sao chép thành supabase/.env (đã nằm trong .gitignore) rồi điền giá trị.
# Supabase CLI tự đọc supabase/.env khi chạy `pnpm db:start`.
# Lấy ở Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Redirect URI cần thêm ở Google: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Gửi thư thật qua Gmail (xem [auth.email.smtp] trong config.toml, mặc định tắt).
# Cần bật xác minh 2 bước cho tài khoản Google, rồi tạo "Mật khẩu ứng dụng" (App password) tại
# https://myaccount.google.com/apppasswords và dán vào SMTP_PASS (16 ký tự, không dùng mật khẩu đăng nhập).
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
