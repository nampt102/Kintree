# Sao chép thành apps/app/.env.local (hoặc chạy `pnpm db:env` để tự ghi hai dòng đầu).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# 1 để hiện nút "Đăng nhập bằng Google" (cần bật [auth.external.google] trong supabase/config.toml)
VITE_AUTH_GOOGLE=

# Chỉ cho Supabase CLI (đặt ở môi trường, không commit):
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
